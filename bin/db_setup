#!/bin/bash

set -e
# debug
# set -x

DB_ROLE_NAMES=${DB_ROLE_NAMES:-USER}
DB_PORT=${DB_PORT:-5432}
DB_TEMPLATE=${DB_TEMPLATE:-template1}
TEST=${TEST:-false}

run_sql() {
  if [ "$TEST" = 'true' ]; then
    echo "Test: $1"
  else
   echo "$1" | PGPASSWORD=$DB_MASTER_PASS psql -p "$DB_PORT" -h "$DB_HOST" -U "$DB_MASTER_USER" template1
   echo $?
  fi
}


if [[ -z "$DB_MASTER_PASS" ]]; then
  echo 'DB_MASTER_PASS not set, no db creation and setup. You are on your own, see the manual for the roles we need' >&2
  exit 0
else

for ROLE_NAME in $DB_ROLE_NAMES;
do

  _DB_USER_NAME="DB_${ROLE_NAME}_NAME"
  _DB_USER_NAME=${!_DB_USER_NAME}
  _DB_USER_PASS="DB_${ROLE_NAME}_PASS"
  _DB_USER_PASS=${!_DB_USER_PASS}
  _DB_USER_ROLES="DB_${ROLE_NAME}_ROLES"
  _DB_USER_ROLES=${!_DB_USER_ROLES:-NOSUPERUSER INHERIT NOCREATEROLE NOCREATEDB LOGIN NOREPLICATION NOBYPASSRLS}

  echo "CREATING DB USER: $_DB_USER_NAME with $_DB_USER_ROLES on ${DB_MASTER_USER}@${DB_HOST}:${DB_PORT}"

SQL=$(cat <<EOF
DO \$\$
BEGIN
  IF EXISTS (
    SELECT
    FROM
      pg_catalog.pg_roles
    WHERE
      rolname = '${_DB_USER_NAME}'
  ) THEN
    ALTER USER "${_DB_USER_NAME}" WITH PASSWORD '${_DB_USER_PASS}';
  ELSE
    CREATE ROLE "${_DB_USER_NAME}" WITH ${_DB_USER_ROLES} ENCRYPTED PASSWORD '${_DB_USER_PASS}';
  END IF;

  GRANT "${_DB_USER_NAME}" TO "${DB_MASTER_USER}";

END
\$\$;
EOF
)
  # create user
  run_sql "$SQL"
  echo "CREATING DATABASE: $DB_NAME $DB_LOCALE $DB_TEMPLATE"
  # create database
  run_sql "SELECT 'CREATE DATABASE \"${DB_NAME}\" WITH LOCALE = ''${DB_LOCALE}'' TEMPLATE = ''${DB_TEMPLATE}'' ENCODING = ''utf-8'' OWNER = ''${DB_OWNER}'''
    WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${DB_NAME}')\gexec"
  echo $?
  # grant
  echo "GRANTING CONNECT $DB_NAME TO $_DB_USER_NAME"
  run_sql "GRANT CONNECT ON DATABASE \"${DB_NAME}\" TO \"${_DB_USER_NAME}\";"
 done
fi
